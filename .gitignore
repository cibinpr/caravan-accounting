# ── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
.pnp/
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ── Environment / Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Keep .env.example committed (it has no real secrets)
!.env.example
!frontend/.env.example

# ── PHP / Composer ────────────────────────────────────────────────────────────
vendor/
api/vendor/
*.phar

# ── Storage (private files, never commit real data) ───────────────────────────
storage/bills/*
storage/logs/*
# Keep the .gitignore and .htaccess inside each storage sub-dir
!storage/bills/.gitignore
!storage/bills/.htaccess
!storage/logs/.gitignore
!storage/logs/.htaccess

# ── Build / Test artifacts ────────────────────────────────────────────────────
dist/
build/
coverage/
*.cache

# ── Editor / OS ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Old / leftover project directories ───────────────────────────────────────
myapp/
backend/
