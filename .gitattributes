# Auto-detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Shell scripts must always be LF (they run on Linux servers)
*.sh text eol=lf

# Windows-specific files get CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — no line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.gz binary
*.tar binary
